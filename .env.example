# Copie este arquivo para .env apenas no seu ambiente local.
# Nunca versione senhas, tokens ou chaves reais.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Arquivos estáticos
# Opcional: por padrão, collectstatic usa <raiz-do-projeto>/staticfiles.
DJANGO_STATIC_ROOT=

# Continuous Delivery / PythonAnywhere
# Use o MESMO valor secreto no GitHub Webhook e no ambiente do servidor.
GITHUB_WEBHOOK_SECRET=gere-um-segredo-aleatorio-forte
PYTHONANYWHERE_USERNAME=seu-usuario
# Opcional: sobrescreve o caminho derivado do username.
PYTHONANYWHERE_WSGI_FILE=
# Opcional: por padrão o projeto usa o diretório que contém manage.py.
DEPLOY_REPOSITORY_PATH=

# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=troque-esta-senha-local
