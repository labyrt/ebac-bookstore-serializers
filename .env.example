# Copie este arquivo para .env apenas no seu ambiente local.
# Nunca versione senhas, tokens ou chaves reais.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=troque-esta-senha-local
